# Public Google OAuth Web client ID for the browser Google Identity Services button.
# Must match GOOGLE_CLIENT_ID in server/.env. This is an identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=

# Vercel / split hosting: full URL of the API when the frontend is deployed separately (must end with /api).
# Leave unset when the API runs on the same domain.
# VITE_API_URL=https://your-api.example.com/api
