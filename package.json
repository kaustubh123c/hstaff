{
  "name": "hstaff-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "npm install && npm install --prefix server",
    "server": "npm start --prefix server",
    "seed": "npm run seed --prefix server",
    "dev:all": "concurrently -k -n api,web -c cyan,magenta \"npm run dev --prefix server\" \"vite\"",
    "start": "vite build && npm start --prefix server",
    "test": "npm test --prefix server && npm run test:ui",
    "test:ui": "node --test src/i18n.test.js",
    "vercel-build": "vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
