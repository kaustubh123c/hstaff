# Copy to server/.env (or set these in your hosting environment).
PORT=4000
NODE_ENV=development
# Local-only codes are generated and shown in the development UI; no SMS is sent.
# This is honored only when NODE_ENV is development or test.
DEV_OTP_ENABLED=true
# Local Admin sign-up page for demos; honored only in development and localhost requests.
DEV_ADMIN_REGISTRATION_ENABLED=true
# Optional Google Identity Services sign-in. Set the same OAuth web client ID in
# the root .env as VITE_GOOGLE_CLIENT_ID. Backend validates audience and signature.
GOOGLE_CLIENT_ID=
# Secrets are auto-generated into server/data/ if you leave these unset. Set them explicitly in production.
# JWT_SECRET=
# QR_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Business rules
REQUIRE_KYC_TO_APPLY=true
ENFORCE_TIME_WINDOW=true
CLOCK_IN_EARLY_MINUTES=30
TZ_OFFSET_MINUTES=330
DEFAULT_GEOFENCE_METERS=200
# Shows demo login chips and "use shift location" buttons. Turn OFF in production.
DEMO_MODE=true

# Razorpay: keep these secrets on the backend only. Never prefix them with VITE_.
# Obtain keys from Razorpay Dashboard after account activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Platform fee percentage retained from the worker's gross timesheet amount (example: 10 = 10%).
PLATFORM_FEE_PERCENT=10

# Phone authentication and job-start code delivery (Twilio). Local OTP mode above takes precedence in development.
# In production, DEV_OTP_ENABLED is ignored and OTPs require a successful configured SMS delivery.
OTP_TTL_SECONDS=300
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=


# --- Vercel / serverless demo (see DEPLOY_VERCEL.md) ---
# Required on Vercel (no auto-generated secrets: the disk is temporary):
# JWT_SECRET=
# QR_SECRET=
# Create this administrator on start-up (password 12+ chars):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# Load sample data when the database is empty (demo only):
# DEMO_SEED=true
# Lets Vercel Cron call /api/cron/auto-approve:
# CRON_SECRET=
